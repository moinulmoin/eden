{
  "name": "@moinulmoin/eden",
  "version": "0.6.0",
  "description": "Deploy existing Eve projects to your own Cloudflare account.",
  "keywords": [
    "ai",
    "agents",
    "cli",
    "cloudflare",
    "durable-objects",
    "eve"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "bin": {
    "eden": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@moinulmoin/eden-runtime-cloudflare": "0.6.0",
    "wrangler": "4.147.0"
  },
  "scripts": {
    "build": "tsc -b",
    "postbuild": "chmod 755 dist/index.js",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm --dir ../.. exec vitest run packages/cli/test --passWithNoTests --maxWorkers=1"
  },
  "devDependencies": {
    "@types/node": "24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moinulmoin/eden.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/moinulmoin/eden#readme",
  "bugs": {
    "url": "https://github.com/moinulmoin/eden/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
