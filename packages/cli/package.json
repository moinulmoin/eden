{
  "name": "@eden/cli",
  "version": "0.1.0",
  "description": "CLI for Eden Deploy and Eden Agent.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "bin": {
    "eden": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@eden/compiler": "workspace:*",
    "@eden/runtime-cloudflare": "workspace:*",
    "chokidar": "5.0.0",
    "wrangler": "4.120.0"
  },
  "scripts": {
    "build": "tsc -b",
    "postbuild": "chmod 755 dist/index.js",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm --dir ../.. exec vitest run packages/cli/test --passWithNoTests --maxWorkers=1"
  },
  "devDependencies": {
    "@types/node": "24.0.0"
  }
}
