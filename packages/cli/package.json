{
  "name": "@eden/cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "bin": {
    "eden": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@eden/compiler": "workspace:*",
    "wrangler": "4.120.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests --maxWorkers=1"
  },
  "devDependencies": {
    "@types/node": "24.0.0"
  }
}
