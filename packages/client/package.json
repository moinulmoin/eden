{
  "name": "@eden/client",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@eden/definitions": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm --dir ../.. exec vitest run packages/client/test --passWithNoTests --maxWorkers=1"
  }
}
