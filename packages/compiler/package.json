{
  "name": "@moinulmoin/eden-compiler",
  "version": "0.1.4",
  "description": "Filesystem compiler for Eden Agents.",
  "type": "module",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@moinulmoin/eden-definitions": "0.1.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm --dir ../.. exec vitest run packages/compiler/test --passWithNoTests --maxWorkers=1"
  },
  "devDependencies": {
    "@types/node": "24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moinulmoin/eden.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/moinulmoin/eden#readme",
  "bugs": {
    "url": "https://github.com/moinulmoin/eden/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
