{
  "name": "@eden/compiler",
  "version": "0.1.0",
  "description": "Filesystem compiler for Eden Agents.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@eden/definitions": "workspace:*",
    "chokidar": "5.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm --dir ../.. exec vitest run packages/compiler/test --passWithNoTests --maxWorkers=1"
  },
  "devDependencies": {
    "@types/node": "24.0.0"
  }
}
