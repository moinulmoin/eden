{
  "name": "eden-runtime-session-tests",
  "main": "src/test-worker.ts",
  "compatibility_date": "2026-04-01",
  "vars": {
    "EDEN_BEARER_SECRET": "eden-unit-auth"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EdenSession"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EDEN_SESSIONS",
        "class_name": "EdenSession"
      }
    ]
  }
}
