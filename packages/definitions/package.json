{
  "name": "@moinulmoin/eden-definitions",
  "version": "0.1.5",
  "description": "Shared definitions for Eden Agents and tools.",
  "type": "module",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm --dir ../.. exec vitest run packages/definitions/test --passWithNoTests --maxWorkers=1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moinulmoin/eden.git",
    "directory": "packages/definitions"
  },
  "homepage": "https://github.com/moinulmoin/eden#readme",
  "bugs": {
    "url": "https://github.com/moinulmoin/eden/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
