{
  "name": "@eden/definitions",
  "version": "0.1.0",
  "description": "Shared definitions for Eden Agents and tools.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
